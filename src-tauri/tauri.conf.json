{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ferric",
  "version": "0.1.0",
  "identifier": "dev.danieldevelopes.ferric",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ferric",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
